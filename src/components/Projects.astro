---
import Section from './Section.astro';

interface Project {
  name: string;
  icon: string;
}

interface Props {
  projects: Project[];
  galleryImages: string[];
}

const { projects, galleryImages } = Astro.props;
---

<section id="proyectos" class="py-16 md:py-24 bg-black" data-images={JSON.stringify(galleryImages)}>
  <div class="section-container">
    <Section title="Proyectos <span>Offroad</span>" subtitle="Equipamiento offroad fabricado en acero para tu Suzuki" />
    <!-- Background -->
    <div class="relative rounded overflow-hidden mb-8 md:mb-10">
      <div class="absolute inset-0">
        <img
          src="/assets/proyectos/Foto fondo seccion Proyectos offroad.jpg"
          alt=""
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-black/60"></div>
      </div>

      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12 p-6 md:p-10 items-center">
        <!-- List -->
        <div class="space-y-6 self-center">
          {projects.map((project) => (
            <div class="flex items-center gap-4 group">
              <img
                src={project.icon}
                alt={project.name}
                class="w-10 h-10 md:w-12 md:h-12 flex-shrink-0 rounded"
              />
              <span class="text-white text-sm md:text-base font-bold uppercase tracking-wider group-hover:text-red transition-colors">
                {project.name}
              </span>
            </div>
          ))}
        </div>

        <!-- Gallery -->
        <div>
          <!-- Main Image -->
          <div class="relative aspect-[4/3] overflow-hidden rounded mb-4 cursor-grab active:cursor-grabbing" id="projects-image-container">
            <img
              src={galleryImages[0] || ''}
              alt="Proyecto 1"
              class="w-full h-full object-cover transition-opacity duration-300 select-none"
              id="projects-main-image"
            />
          </div>

          <!-- Dots -->
          <div class="flex justify-center gap-2" id="projects-dots">
            {galleryImages.map((_, i) => (
              <button
                class="w-2.5 h-2.5 rounded-full transition-all duration-300 bg-gray-dark hover:bg-gray"
                data-index={i}
                aria-label={'Proyecto ' + (i + 1)}
              />
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script client:load>
  (function() {
    const section = document.getElementById('proyectos');
    const images = JSON.parse(section?.dataset.images || '[]');
    const mainImage = document.getElementById('projects-main-image');
    const dotsContainer = document.getElementById('projects-dots');
    let currentIndex = 0;

    function updateGallery(index) {
      currentIndex = index;
      mainImage.src = images[index];
      mainImage.alt = 'Proyecto ' + (index + 1);
      dotsContainer.querySelectorAll('button').forEach((dot, i) => {
        if (i === index) {
          dot.className = 'w-2.5 h-2.5 rounded-full transition-all duration-300 bg-red w-8';
        } else {
          dot.className = 'w-2.5 h-2.5 rounded-full transition-all duration-300 bg-gray-dark hover:bg-gray';
        }
      });
    }

    dotsContainer.addEventListener('click', (e) => {
      if (e.target.tagName === 'BUTTON') {
        const index = parseInt(e.target.dataset.index);
        updateGallery(index);
      }
    });

    const mainImg = document.getElementById('projects-main-image');
    let startX = 0;
    let isDragging = false;
    const minSwipeDistance = 50;

    mainImg.addEventListener('mousedown', (e) => {
      startX = e.clientX;
      isDragging = true;
      e.preventDefault();
    });

    mainImg.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
      isDragging = true;
    }, { passive: true });

    window.addEventListener('mouseup', (e) => {
      if (!isDragging) return;
      isDragging = false;
      const diff = startX - e.clientX;
      if (Math.abs(diff) > minSwipeDistance) {
        if (diff > 0 && currentIndex < images.length - 1) {
          updateGallery(currentIndex + 1);
        } else if (diff < 0 && currentIndex > 0) {
          updateGallery(currentIndex - 1);
        }
      }
    });

    window.addEventListener('touchend', (e) => {
      if (!isDragging) return;
      isDragging = false;
      const changedTouch = e.changedTouches[0];
      const diff = startX - changedTouch.clientX;
      if (Math.abs(diff) > minSwipeDistance) {
        if (diff > 0 && currentIndex < images.length - 1) {
          updateGallery(currentIndex + 1);
        } else if (diff < 0 && currentIndex > 0) {
          updateGallery(currentIndex - 1);
        }
      }
    });
  })();
</script>
