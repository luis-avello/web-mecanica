---
import Section from './Section.astro';
import Gallery from './Gallery.astro';

interface Project {
  name: string;
  icon: string;
}

interface Props {
  projects: Project[];
  galleryImages: string[];
}

const { projects, galleryImages } = Astro.props;
---

<section id="proyectos" class="py-16 md:py-24 bg-black">
  <div class="section-container">
    <Section title="Proyectos <span>Offroad</span>" subtitle="Equipamiento offroad fabricado en acero para tu Suzuki" />
    <!-- Background -->
    <div class="relative rounded overflow-hidden mb-8 md:mb-10">
      <div class="absolute inset-0">
        <img
          src="/assets/proyectos/Foto fondo seccion Proyectos offroad.jpg"
          alt=""
          aria-hidden="true"
          role="presentation"
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-black/80"></div>
      </div>

      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12 p-6 md:p-10 items-center">
        <!-- List -->
        <div class="space-y-6 self-center">
          {projects.map((project) => (
            <div class="flex items-center gap-4 group">
              <img
                src={project.icon}
                alt={project.name}
                loading="lazy"
                decoding="async"
                class="w-10 h-10 md:w-12 md:h-12 flex-shrink-0 rounded"
              />
              <span class="text-white text-sm md:text-base font-bold uppercase tracking-wider group-hover:text-red transition-colors">
                {project.name}
              </span>
            </div>
          ))}
        </div>

        <!-- Gallery -->
        <Gallery images={galleryImages} label="Proyecto" />
      </div>
    </div>
  </div>
</section>
