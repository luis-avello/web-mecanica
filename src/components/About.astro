---
import Section from './Section.astro';
import Gallery from './Gallery.astro';

interface Props {
  title?: string;
  paragraphs?: string[];
  galleryImages?: string[];
}

const { title = 'Quiénes Somos', paragraphs = [], galleryImages = [] } = Astro.props;
---

<section id="quienes-somos" class="py-16 md:py-24 bg-black">
  <div class="section-container">
    <Section title="Quiénes <span>Somos</span>" />
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">
      <!-- Text -->
      <div class="space-y-5">
        {paragraphs.map((paragraph) => (
          <p class="text-gray leading-relaxed text-sm md:text-base">{paragraph}</p>
        ))}
      </div>

      <!-- Gallery -->
      <Gallery images={galleryImages} label="Foto" altPrefix="Mecánica Avello - " />
    </div>
  </div>
</section>
