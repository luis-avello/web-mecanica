---
import Section from './Section.astro';
import siteData from '../content/site.json';
import IconPhone from './icons/IconPhone.astro';
import IconInstagram from './icons/IconInstagram.astro';
import IconMail from './icons/IconMail.astro';
---

<section id="contacto" class="py-16 md:py-24 bg-black">
  <div class="section-container">
    <Section title="Contáctanos" subtitle="Confiános el servicio de tu vehículo" />
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
      <!-- Phone -->
      <a
        href={`tel:${siteData.phone}`}
        class="group bg-black-lighter border border-white/10 hover:border-red/50 p-6 md:p-8 text-center transition-colors"
      >
        <div class="flex justify-center mb-4">
          <IconPhone class="w-8 h-8 text-red group-hover:text-white transition-colors" />
        </div>
        <h3 class="text-white font-bold uppercase tracking-wider text-sm mb-2">Celular</h3>
        <p class="text-gray group-hover:text-white transition-colors">{siteData.phone}</p>
      </a>

      <!-- Instagram -->
      <a
        href={siteData.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="group bg-black-lighter border border-white/10 hover:border-red/50 p-6 md:p-8 text-center transition-colors"
      >
        <div class="flex justify-center mb-4">
          <IconInstagram class="w-8 h-8 text-red group-hover:text-white transition-colors" />
        </div>
        <h3 class="text-white font-bold uppercase tracking-wider text-sm mb-2">Instagram</h3>
        <p class="text-gray group-hover:text-white transition-colors">@mecanicaavello_canoavello</p>
      </a>

      <!-- Email -->
      <a
        href={`mailto:${siteData.email}`}
        class="group bg-black-lighter border border-white/10 hover:border-red/50 p-6 md:p-8 text-center transition-colors"
      >
        <div class="flex justify-center mb-4">
          <IconMail class="w-8 h-8 text-red group-hover:text-white transition-colors" />
        </div>
        <h3 class="text-white font-bold uppercase tracking-wider text-sm mb-2">Correo</h3>
        <p class="text-gray group-hover:text-white transition-colors">{siteData.email}</p>
      </a>
    </div>
  </div>
</section>
