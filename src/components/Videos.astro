---
import Section from './Section.astro';

interface Video {
  title: string;
  embedId: string;
}

interface Props {
  videos: Video[];
}

const { videos } = Astro.props;
import siteData from '../content/site.json';
---

<section id="videos" class="py-16 md:py-24 bg-black">
  <div class="section-container">
    <Section title="Videos" subtitle="Sigue nuestras aventuras 4x4 en RRSS, YouTube, Instagram y TikTok." />
    <!-- Main Video -->
    <div class="mb-8">
      <div
        class="relative aspect-video rounded overflow-hidden bg-black-lighter video-lazy cursor-pointer group"
        data-embed={videos[0]?.embedId}
        data-title={videos[0]?.title}
      >
        <img
          src={'https://i.ytimg.com/vi/' + (videos[0]?.embedId || '') + '/hqdefault.jpg'}
          alt={videos[0]?.title || 'Video Mecánica Avello'}
          loading="lazy"
          decoding="async"
          class="absolute inset-0 w-full h-full object-cover"
        />
        <div class="absolute inset-0 flex items-center justify-center bg-black/40 group-hover:bg-black/60 transition-colors">
          <svg class="w-16 h-16 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8 5v14l11-7z"/>
          </svg>
        </div>
      </div>
    </div>

    <!-- Video Thumbnails -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
      {videos.slice(1).map((video) => (
        <div
          class="relative aspect-video rounded overflow-hidden bg-black-lighter video-lazy cursor-pointer group"
          data-embed={video.embedId}
          data-title={video.title}
        >
          <img
            src={'https://i.ytimg.com/vi/' + video.embedId + '/hqdefault.jpg'}
            alt={video.title}
            loading="lazy"
            decoding="async"
            class="absolute inset-0 w-full h-full object-cover"
          />
          <div class="absolute inset-0 flex items-center justify-center bg-black/40 group-hover:bg-black/60 transition-colors">
            <svg class="w-12 h-12 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M8 5v14l11-7z"/>
            </svg>
          </div>
        </div>
      ))}
    </div>

    <!-- YouTube Link -->
    <div class="text-center">
      <a
        href={siteData.youtube}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-red hover:bg-red-hover text-white text-sm font-bold uppercase tracking-wider px-8 py-3 transition-colors"
      >
        Ir a YouTube
      </a>
    </div>
  </div>
</section>

<script client:load>
  (function() {
    document.querySelectorAll('.video-lazy').forEach(function(container) {
      container.addEventListener('click', function() {
        if (container.querySelector('iframe')) return;
        var embed = container.dataset.embed;
        var title = container.dataset.title || '';
        if (!embed) return;
        var iframe = document.createElement('iframe');
        iframe.src = 'https://www.youtube.com/embed/' + embed + '?autoplay=1&rel=0';
        iframe.title = title;
        iframe.className = 'absolute inset-0 w-full h-full';
        iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture');
        iframe.setAttribute('allowfullscreen', '');
        iframe.setAttribute('loading', 'lazy');
        container.appendChild(iframe);
      });
    });
  })();
</script>
