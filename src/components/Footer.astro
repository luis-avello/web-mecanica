---
import siteData from '../content/site.json';
import IconPhone from './icons/IconPhone.astro';
import IconInstagram from './icons/IconInstagram.astro';
import IconMail from './icons/IconMail.astro';
---

<footer class="bg-black-light border-t border-gray-dark/20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12">
      <!-- Logo + Tagline -->
      <div>
        <img src="/assets/logo sin fondo.webp" alt="Mecánica Avello" width="2048" height="986" class="h-16 w-auto mb-4" />
        <p class="text-gray text-sm leading-relaxed">
          {siteData.tagline}
        </p>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-white font-bold uppercase tracking-wider text-sm mb-4">Contáctanos</h3>
        <div class="space-y-3">
          <a href={`tel:${siteData.phone}`} class="flex items-center gap-3 text-gray hover:text-white transition-colors group">
            <IconPhone class="w-5 h-5 text-red group-hover:text-white transition-colors" />
            <span class="text-sm">{siteData.phone}</span>
          </a>
          <a href={siteData.instagram} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-gray hover:text-white transition-colors group">
            <IconInstagram class="w-5 h-5 text-red group-hover:text-white transition-colors" />
            <span class="text-sm">@mecanicaavello_canoavello</span>
          </a>
          <a href={`mailto:${siteData.email}`} class="flex items-center gap-3 text-gray hover:text-white transition-colors group">
            <IconMail class="w-5 h-5 text-red group-hover:text-white transition-colors" />
            <span class="text-sm">{siteData.email}</span>
          </a>
        </div>
      </div>

      <!-- Address -->
      <div>
        <h3 class="text-white font-bold uppercase tracking-wider text-sm mb-4">Ubicación</h3>
        <p class="text-gray text-sm leading-relaxed mb-4">
          {siteData.address}
        </p>
        <a
          href={siteData.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block bg-red  hover:bg-red-hover text-white text-xs font-bold uppercase tracking-wider px-5 py-2.5 transition-colors"
        >
          Cómo Llegar
        </a>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-gray-dark/20 mt-10 pt-6 text-center">
      <p class="text-gray-dark text-xs">&copy; <span id="footer-year">{new Date().getFullYear()}</span> Mecánica Avello SPA. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>

<script client:load>
(function() {
  const yearEl = document.getElementById('footer-year');
  if (yearEl) {
    yearEl.textContent = String(new Date().getFullYear());
  }
})();
</script>
