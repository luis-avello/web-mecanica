---
import Section from './Section.astro';
import siteData from '../content/site.json';

interface CardItem {
  name: string;
  image: string;
  icon: string;
}

interface Props {
  id: string;
  title: string;
  items: CardItem[];
  ctaText?: string;
  ctaHref?: string;
}

const { id, title, items, ctaText = 'Contáctanos', ctaHref = siteData.whatsapp } = Astro.props;
---

<section id={id} class="py-16 md:py-24 bg-black">
  <div class="section-container">
    <Section title={title} />
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
      {items.map((item) => (
        <div class="group cursor-pointer">
          <!-- Image -->
          <div class="relative overflow-hidden mb-0 aspect-[4/3]">
            <img
              src={item.image}
              alt={item.name}
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <!-- Label -->
          <div class="bg-black-lighter border border-white/10 px-4 py-3 flex items-center gap-3 group-hover:border-red/50 transition-colors">
            <img src={item.icon} alt="" class="w-8 h-8 object-contain opacity-80" />
            <span class="text-white text-xs md:text-sm font-bold uppercase tracking-wider leading-tight">
              {item.name}
            </span>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-8 md:mt-10 text-center">
      <a
        href={ctaHref}
        class="inline-block bg-red hover:bg-red-hover text-white text-sm font-bold uppercase tracking-wider px-8 py-3 transition-colors"
      >
        {ctaText}
      </a>
    </div>
  </div>
</section>
