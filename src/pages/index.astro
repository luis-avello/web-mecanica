---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import CardGrid from '../components/CardGrid.astro';
import Projects from '../components/Projects.astro';
import Videos from '../components/Videos.astro';
import Location from '../components/Location.astro';
import Contact from '../components/Contact.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

import '../styles/global.css';

import servicesData from '../content/services.json';
import productsData from '../content/products.json';
import projectsData from '../content/projects.json';
import videosData from '../content/videos.json';
import aboutData from '../content/about.json';
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow" />
    <meta name="description" content="Mecánica Avello SPA - Taller mecánico especializado en vehículos 4x4, SUV y camionetas en Padre Hurtado, Santiago. Mantención preventiva, diagnóstico y reparación Suzuki, Mahindra, Toyota, Nissan." />
    <meta name="keywords" content="mecánica, taller mecánico, 4x4, SUV, camionetas, Suzuki, Mahindra, Toyota, Nissan, mantención preventiva, Padre Hurtado, Melipilla" />
    <meta name="theme-color" content="#0A0A0A" />
    <link rel="canonical" href="https://mecanicaavello.cl/" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mecánica Avello" />
    <meta property="og:title" content="Mecánica Avello - Servicio Mecánico Especializado 4x4, SUV y Camionetas en Padre Hurtado" />
    <meta property="og:description" content="Especialistas en mantención preventiva, diagnóstico y reparación de vehículos 4x4, SUV y camionetas. Taller en Camino a Melipilla 2000, Padre Hurtado, Santiago." />
    <meta property="og:url" content="https://mecanicaavello.cl/" />
    <meta property="og:image" content="https://mecanicaavello.cl/og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Mecánica Avello - Servicio Mecánico Especializado 4x4, SUV y Camionetas" />
    <meta name="twitter:description" content="Especialistas en mantención preventiva, diagnóstico y reparación de vehículos 4x4, SUV y camionetas en Padre Hurtado, Santiago." />
    <meta name="twitter:image" content="https://mecanicaavello.cl/og-image.jpg" />
    <title>Mecánica Avello - Servicio Mecánico Especializado 4x4, SUV y Camionetas | Padre Hurtado</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&amp;display=swap" rel="stylesheet" />
    <link rel="preconnect" href="https://www.youtube.com" />
    <link rel="preconnect" href="https://i.ytimg.com" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "AutoRepair",
      "name": "Mecánica Avello SPA",
      "description": "Taller mecánico especializado en mantención preventiva, diagnóstico y reparación de vehículos 4x4, SUV, camionetas y automóviles.",
      "image": "https://mecanicaavello.cl/og-image.jpg",
      "url": "https://mecanicaavello.cl",
      "telephone": "+56 9 7213 5168",
      "email": "mecanica.avello@gmail.com",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Camino a Melipilla 2000, Bodega 2",
        "addressLocality": "Padre Hurtado",
        "addressRegion": "Santiago",
        "addressCountry": "CL"
      },
      "sameAs": [
        "https://www.youtube.com/@mecanicaavello4x4",
        "https://instagram.com/mecanicaavello_canoavello",
        "https://wa.me/56972135168"
      ]
    })} />
    <Analytics />
    <SpeedInsights />
  </head>
  <body>
    <Header />
    <main>
      <Hero />
      <About title={aboutData.title} paragraphs={aboutData.paragraphs} galleryImages={aboutData.galleryImages} />
      <CardGrid id="servicios" title="Servicios" items={servicesData} />
      <CardGrid id="productos" title="Productos" items={productsData} />
      <Projects projects={projectsData.projects} galleryImages={projectsData.galleryImages} />
      <Videos videos={videosData} />
      <Location />
      <Contact />
    </main>
    <Footer />
  </body>
</html>
